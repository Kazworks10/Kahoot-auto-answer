{
  "manifest_version": 3,
  "name": "Kahoot Auto Answer",
  "version": "1.2.0",
  "description": "Detects the Kahoot quiz you're playing, then auto-answers or highlights the correct answers.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://create.kahoot.it/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Kahoot Auto Answer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://kahoot.it/*"
      ],
      "js": [
        "src/bridge.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://kahoot.it/*"
      ],
      "js": [
        "src/page.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
